{
  "name": "personal-software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI software factory control plane monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "check": "pnpm typecheck && pnpm test",
    "psf": "tsx scripts/psf.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "check:packages": "pnpm -r check",
    "db:generate": "pnpm --filter @psf/db prisma generate --schema prisma/schema.prisma",
    "db:migrate": "pnpm --filter @psf/db prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @psf/db seed",
    "dev:api": "pnpm --filter @psf/orchestrator-api dev",
    "dev": "pnpm dev:api"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@psf/codex-worker": "workspace:*",
    "@psf/db": "workspace:*",
    "@psf/mission-planner": "workspace:*",
    "@psf/project-registry": "workspace:*",
    "@types/node": "^25.9.1",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
