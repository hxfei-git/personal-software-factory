# Local development defaults only. Replace token values in .env; do not commit real secrets.
# Leave secret placeholders empty here; no real tokens, passwords, cookies, or keys belong in git.
NODE_ENV=development

# API auth. GET /health is public; write routes require Authorization: Bearer <PSF_API_TOKEN>
# unless PSF_AUTH_DISABLED=true. Keep disabled auth limited to local development and tests.
PSF_API_TOKEN=
PSF_AUTH_DISABLED=false

# Project registry and local dry-run roots.
PSF_PROJECTS_ROOT=projects
PSF_SKIP_DB=0
ARTIFACTS_DIR=./artifacts
WORKSPACES_DIR=./workspaces

# Demo reset safety. Set only when intentionally clearing demo namespace.
DEMO_RESET_CONFIRM=0

# Optional doctor checks.
PSF_DOCTOR_CHECK_API=0
PSF_DOCTOR_CHECK_HUB=0

# Codex execution safety. Keep disabled unless a local, approved, gated run is intentional.
# CODEX_EXECUTABLE must be an explicit absolute path in real mode; do not commit tokens.
ENABLE_REAL_CODEX=0
CODEX_EXECUTABLE=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_MODE=on-request
PSF_WORKSPACE_ROOT=./workspaces
PSF_REAL_CODEX_MAX_RUNTIME_MS=300000

# Local Docker Compose database defaults.
POSTGRES_USER=psf
POSTGRES_PASSWORD=psf_dev_password
POSTGRES_DB=psf
DATABASE_URL=postgresql://psf:psf_dev_password@localhost:5432/psf?schema=public

# Local Redis and optional queue-backed Worker Runtime.
REDIS_URL=redis://localhost:6379
PSF_WORKER_RUNTIME=in-process
PSF_ACTION_EXECUTION_MODE=inline
PSF_REDIS_URL=redis://127.0.0.1:6379
PSF_QUEUE_PREFIX=psf
PSF_WORKER_CONCURRENCY=2
PSF_JOB_ATTEMPTS=2
PSF_JOB_TIMEOUT_MS=300000
PSF_TEST_REDIS=0

# Protected Orchestrator real-action route gates. These require queued mode, approvals,
# Worker Runner support, and worker/provider gates before real work can occur.
PSF_ENABLE_REAL_CODEX=false
PSF_ENABLE_REAL_QA_PLAYWRIGHT=false
PSF_ENABLE_REAL_QA_AI_EXPLORATORY=false
PSF_ENABLE_REAL_FIX=false
PSF_ENABLE_REAL_GITHUB_PR=false
PSF_ENABLE_REAL_COOLIFY_DEPLOY=false
PSF_ENABLE_REAL_UPTIME_KUMA_SYNC=false
PSF_ENABLE_REAL_PLANE_SYNC=false

# Orchestrator API bind address.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=3000

# Hub Web local defaults. Vite reads VITE_* variables in the browser bundle.
VITE_ORCHESTRATOR_API_URL=http://127.0.0.1:3000
VITE_PSF_API_TOKEN=

# Optional QA execution. Normal pnpm test does not require these.
# Do not store real browser session secrets or provider credentials in QA pages or artifacts.
STAGING_URL=
QA_TEST_URL=
ENABLE_REAL_PLAYWRIGHT=0
ENABLE_AI_EXPLORATORY_QA=0
PSF_MAX_MISSION_FIX_ATTEMPTS=3
PSF_MAX_BUG_FIX_ATTEMPTS=2

# GitHub integration inputs. ENABLE_REAL_GITHUB=1 only makes real mode eligible;
# real PR/network actions still require queued route gates, approvals, and injected transport.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
ENABLE_REAL_GITHUB=0

# Coolify integration inputs. ENABLE_REAL_COOLIFY=1 does not perform deploys by itself.
COOLIFY_BASE_URL=
COOLIFY_TOKEN=
ENABLE_REAL_COOLIFY=0

# Uptime Kuma integration inputs. ENABLE_REAL_UPTIME_KUMA=1 does not create monitors by itself.
UPTIME_KUMA_BASE_URL=
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=
ENABLE_REAL_UPTIME_KUMA=0

# Plane integration inputs. ENABLE_REAL_PLANE=1 does not create or update issues by itself.
PLANE_BASE_URL=
PLANE_API_TOKEN=
PLANE_WORKSPACE_ID=
PLANE_PROJECT_ID=
ENABLE_REAL_PLANE=0
