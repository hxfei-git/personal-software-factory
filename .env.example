# Local development defaults only. Replace token values in .env; do not commit real secrets.
NODE_ENV=development

# API auth. GET /health is public; write routes require Authorization: Bearer <PSF_API_TOKEN>
# unless PSF_AUTH_DISABLED=true. Keep disabled auth limited to local development and tests.
PSF_API_TOKEN=replace-with-local-dev-token
PSF_AUTH_DISABLED=false

# Project registry and local dry-run roots.
PSF_PROJECTS_ROOT=projects
PSF_SKIP_DB=0
ARTIFACTS_DIR=./artifacts
WORKSPACES_DIR=./workspaces

# Codex execution safety. Keep disabled until a later approved real-worker task exists.
ENABLE_REAL_CODEX=0

# Local Docker Compose database defaults.
POSTGRES_USER=psf
POSTGRES_PASSWORD=psf_dev_password
POSTGRES_DB=psf
DATABASE_URL=postgresql://psf:psf_dev_password@localhost:5432/psf?schema=public

# Local Redis placeholder for later queue work.
REDIS_URL=redis://localhost:6379

# Orchestrator API bind address.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=3000
